# Keep generated publication output and pinned third-party libraries from
# overwhelming GitHub's language statistics and code-review views.
docs/** linguist-generated=true
assets/vendor/** linguist-vendored=true
docs/assets/vendor/** linguist-vendored=true
docs/site_libs/** linguist-vendored=true
